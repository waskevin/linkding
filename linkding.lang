# Multilingual file for TOS 7 Docker application. All 14 languages are REQUIRED.

[en-us]
name = "Linkding"
auth = "waskevin"
descript = "Linkding is a self-hosted bookmark manager for your TNAS. Save links from any browser, organise them with tags, and find them again with full-text search and automatically fetched website metadata. All bookmarks live in a single SQLite file that is easy to back up."
release_note = "1. Initial release."
important = "Sign in with user admin. On first start a random password is generated inside the application data directory, in the hidden file data/.admin_password - read it there and change it after the first login. Docker Engine must be installed and enabled from the TOS App Center."

[zh-cn]
name = "Linkding"
auth = "waskevin"
descript = "Linkding 是运行在 TNAS 上的自建书签管理器。可从任意浏览器保存链接，用标签整理，并依靠全文检索和自动抓取的网页元数据快速找回。所有书签都保存在单个便于备份的 SQLite 文件中。"
release_note = "1. Initial release."
important = "使用用户名 admin 登录。首次启动时会在应用数据目录的隐藏文件 data/.admin_password 中生成一个随机密码，请读取该文件并在首次登录后修改密码。需先在应用中心安装并启用 DockerEngine。"

